<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OWWMM.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <SimpleTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0E1016" />
      <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, sans-serif" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#7967FF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#3A2027" />
      <Setter Property="Foreground" Value="#FF9BAB" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.icon-button.compact">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.viewer">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#D91B1F2A" />
      <Setter Property="Foreground" Value="#E6E9F2" />
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="Button.viewer:pointerover">
      <Setter Property="Background" Value="#A796FF" />
      <Setter Property="Foreground" Value="#11131A" />
    </Style>
    <Style Selector="Button.viewer.arrow">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="74" />
      <Setter Property="FontSize" Value="34" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#151821" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#252A37" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="#7967FF" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#2A2750" />
    </Style>
  </Application.Styles>
</Application>
